{% extends 'partials/base.html.twig' %}

{% block footer %}
    {{ parent() }}
    {# Without a real key Snipcart only fails its session request, which jQuery 3 reports as an uncaught error #}
    {% set snipcart_key = header.snipcart.api_key %}
    {% if snipcart_key and snipcart_key != 'YOUR_API_KEY' %}
    <script type="text/javascript"
    id="snipcart"
    src="https://cdn.snipcart.com/scripts/2.0/snipcart.js"
    data-api-key="{{ snipcart_key }}"></script>
    {% endif %}
{% endblock %}

{% block header_extra %}
    {% include 'partials/snipcart_cart.html.twig' %}
{% endblock %}

{% block content %}
    {% if config.plugins.breadcrumbs.enabled %}
        {% include 'partials/breadcrumbs.html.twig' ignore missing %}
    {% endif %}
{% endblock %}
